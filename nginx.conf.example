# Clubtagger nginx configuration example
# Copy to /etc/nginx/sites-available/clubtagger and symlink to sites-enabled
#
# Generate self-signed cert. Substitute <host-ip> with the address you browse
# to — it must match, or the cert won't validate:
#   mkdir -p /etc/nginx/ssl
#   openssl req -x509 -nodes -days 3650 -newkey rsa:2048 \
#     -keyout /etc/nginx/ssl/clubtagger.key \
#     -out /etc/nginx/ssl/clubtagger.crt \
#     -subj "/CN=<host-ip>" \
#     -addext "subjectAltName=IP:<host-ip>"
#
# Generate password file:
#   htpasswd -Bc /etc/nginx/clubtagger.htpasswd <user>

upstream clubtagger {
    server unix:/run/clubtagger.sock;
}

# Redirect HTTP to HTTPS
server {
    listen 80;
    server_name _;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name _;

    ssl_certificate /etc/nginx/ssl/clubtagger.crt;
    ssl_certificate_key /etc/nginx/ssl/clubtagger.key;

    # Basic auth
    auth_basic "Clubtagger";
    auth_basic_user_file /etc/nginx/clubtagger.htpasswd;

    # Static files (HTML, JS, CSS)
    location / {
        root /var/www/clubtagger;
        index index.html;
        try_files $uri $uri/ =404;
    }

    # Recordings: FLAC segments and their .peaks waveform sidecars, written by
    # clubtagger to /data/recordings (--outdir). The recorder stages files in
    # /data/recordings/.incoming/ (a dot-directory autoindex never lists) and
    # renames them into place, so every listed file is complete.
    #   /recordings/       human-readable listing + the files themselves
    #                      (Range requests let recordings.html audition and export)
    #   /recordings-json/  the same directory as JSON, read by recordings.html
    location /recordings/ {
        root /data;
        # Exports pull gigabytes through TLS. Cap each download so nginx cannot
        # saturate the core the recorder encodes on (2 GB still takes < 2 min on LAN).
        limit_rate 20m;
        autoindex on;
        location ~ \.peaks$ {
            add_header Cache-Control "public, max-age=2592000, immutable";
        }
    }
    location /recordings-json/ {
        alias /data/recordings/;
        autoindex on;
        autoindex_format json;
        autoindex_exact_size on;
        gzip on;
        gzip_types application/json;
    }

    # WebSocket proxy to clubtagger Unix socket.
    #
    # auth_basic is off here because browsers don't reliably attach Basic Auth
    # credentials to a WebSocket handshake. This endpoint is therefore
    # UNAUTHENTICATED: anyone who can reach this host can connect to /ws and
    # read the live deck and track stream. Basic auth on the page itself does
    # not protect it — the URL is not a secret. Only expose this on a network
    # you trust, or put a real check (token or session cookie) on the upgrade.
    location = /ws {
        auth_basic off;
        proxy_pass http://clubtagger;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Disable buffering for real-time data
        proxy_buffering off;
        proxy_cache off;

        # Long timeout for WebSocket connections
        proxy_read_timeout 24h;
        proxy_send_timeout 24h;
    }
}
