# nginx on the backup NAS: recordings browser + files over plain HTTP,
# protected by signed URLs (secure_link) instead of a password.
#
# Why plain HTTP: TLS on the NAS (an OXE810) manages ~2 MB/s, so a 2 GB set
# would take a quarter of an hour. Why secure_link: the page signs every
# request with md5(expires + uri + " " + secret); the secret never crosses
# the wire, nginx only checks the signature and the expiry. An eavesdropper
# sees the audio (not secret) and can replay a URL until it expires.
#
# Requires nginx built with the secure_link module
# (Buildroot: BR2_PACKAGE_NGINX_HTTP_SECURE_LINK_MODULE=y).
# Put the same secret into the page: open /recordings.html, click the key
# button, paste it. Change SECRET below (and in the page) to rotate.

server {
    listen 80;
    server_name _;

    root /var/www/clubtagger;          # recordings.html, recordings.js, timeline.js,
                                       # flac-splice.js, flac-splice.worker.js, md5.js
    location = / { return 302 /recordings.html; }
    location / {
        # The page itself is public code; it is useless without the secret.
        try_files $uri =404;
    }

    # The directory the recorder pushes into (rsync module "recordings").
    location /recordings/ {
        alias /srv/recordings/;
        secure_link $arg_md5,$arg_expires;
        secure_link_md5 "$secure_link_expires$uri SECRET";
        if ($secure_link = "")  { return 403; }
        if ($secure_link = "0") { return 410; }
        autoindex on;
    }

    # Same directory as JSON, read by recordings.html.
    location /recordings-json/ {
        alias /srv/recordings/;
        secure_link $arg_md5,$arg_expires;
        secure_link_md5 "$secure_link_expires$uri SECRET";
        if ($secure_link = "")  { return 403; }
        if ($secure_link = "0") { return 410; }
        autoindex on;
        autoindex_format json;
        autoindex_exact_size on;
        gzip on;
        gzip_types application/json;
    }
}
