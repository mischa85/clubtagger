# nginx on the backup NAS. Two ways to protect it; pick one.
#
# A) A router/proxy in front terminates HTTPS and basic auth
#    (tools/router-nginx.conf.example) and this box serves plain HTTP to that
#    proxy only. Recommended: no crypto on the NAS, no signed URLs, no browser
#    flags. Use the "allow <router>" lines and drop every secure_link line.
#
# B) Browsers talk to this box directly over plain HTTP. Then keep the
#    secure_link lines (signed URLs, the access key never crosses the wire) and
#    start Chrome with --unsafely-treat-insecure-origin-as-secure=http://<nas>
#    for exporting. Requires BR2_PACKAGE_NGINX_HTTP_SECURE_LINK_MODULE=y.
#
# The recorder pushes into /srv/recordings with rsync (tools/nas-rsyncd.conf.example).

server {
    listen 80;
    server_name _;

    # A) only the reverse proxy may talk to us
    allow 192.168.2.1;                 # the router
    allow 127.0.0.1;
    deny  all;

    root /var/www/clubtagger;          # recordings.html, recordings.js, timeline.js,
                                       # flac-splice.js, flac-splice.worker.js, md5.js
    location = / { return 302 /recordings.html; }
    location / {
        try_files $uri =404;
    }

    # The directory the recorder pushes into (rsync module "recordings").
    location /recordings/ {
        alias /srv/recordings/;
        # B) signed URLs instead of a proxy:
        # secure_link $arg_md5,$arg_expires;
        # secure_link_md5 "$secure_link_expires$uri SECRET";
        # if ($secure_link = "")  { return 403; }
        # if ($secure_link = "0") { return 410; }
        autoindex on;
    }

    # Same directory as JSON, read by recordings.html.
    location /recordings-json/ {
        alias /srv/recordings/;
        # B) as above
        autoindex on;
        autoindex_format json;
        autoindex_exact_size on;
        gzip on;
        gzip_types application/json;
    }
}
