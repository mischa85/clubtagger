# nginx on the router in front of the NAS (OpenWrt on a MediaTek MT7986A:
# Cortex-A53 with ARMv8 crypto, TLS at line rate). Terminates HTTPS and basic
# auth, proxies to the NAS over plain HTTP on the internal segment. The NAS
# then serves without any crypto and needs no signed URLs; the recordings page
# is an ordinary HTTPS site, so the export works in any Chrome/Edge without
# flags.
#
#   opkg install nginx-ssl              # uhttpd cannot reverse proxy
#   /etc/nginx/conf.d/recordings.conf   # this file
#   certificate: acme.sh with the duckdns DNS challenge, or a self-signed one
#   htpasswd:    same format as the recorder's /etc/nginx/clubtagger.htpasswd
#
# Forward the public port (e.g. 20125) to this server's 443 in the firewall.

server {
    listen 443 ssl;
    server_name _;

    ssl_certificate     /etc/nginx/recordings.crt;
    ssl_certificate_key /etc/nginx/recordings.key;

    auth_basic "Recordings";
    auth_basic_user_file /etc/nginx/recordings.htpasswd;

    location / {
        proxy_pass http://192.168.2.20;        # the NAS, plain HTTP (its nginx allows only this router)
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Authorization "";     # the NAS does no auth; do not leak the password to it

        # gigabyte downloads: stream, do not spool to disk on the router
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_max_temp_file_size 0;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }
}
